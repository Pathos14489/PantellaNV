scn PantellaMCMScript
short iMaster
short iMouseover
short iOption
short iTemp
float fTemp
float fValue
reference rList

int AddToConversationKeyCode
int ClearActiveConversationsKeyCode
int OpenTextMenuKeyCode
int microphoneEnabled

begin GameMode
	if GetGameRestarted
		if IsModLoaded "The Mod Configuration Menu.esp"
			set iMaster to GetModIndex "The Mod Configuration Menu.esp"
			set rList to BuildRef iMaster 2790
		    ListAddForm rList PantellaMCM

			; Set default key code for Add To Conversation to H key
			AddToConversationKeyCode = 35
			SetUIFloat "StartMenu/MCM/*:1/*:3/value/*:1/number" AddToConversationKeyCode
			; Set default key code for Clear Active Conversations to Backspace key
			ClearActiveConversationsKeyCode = 14
			SetUIFloat "StartMenu/MCM/*:1/*:4/value/*:1/number" ClearActiveConversationsKeyCode
			; Set default key code for Open Text Menu to B key
			OpenTextMenuKeyCode = 48
			SetUIFloat "StartMenu/MCM/*:1/*:5/value/*:1/number" OpenTextMenuKeyCode
			; Set default value for microphone enabled to 0 (disabled)
			int microphoneFileExists = FileExists "_pantella_microphone_enabled.txt" 0
			if microphoneFileExists
				string_var microphoneEnabledStr = ReadStringFromFile "_pantella_microphone_enabled.txt"
				if eval microphoneEnabledStr == "True"
					microphoneEnabled = 1
				else
					microphoneEnabled = 0
				endif
			else
				microphoneEnabled = 0
				WriteStringToFile "_pantella_microphone_enabled.txt" 0 "False"
			endif
			SetUIFloat "StartMenu/MCM/*:1/*:6/value/*:1/number" microphoneEnabled

			SetEventHandler "OnKeyDown:48" PantellaOpenTextMenu ; On B Key Pressed
			SetEventHandler "OnKeyDown:35" PantellaAddToConversation ; On H Key Pressed
			SetEventHandler "OnKeyDown:14" PantellaClearActiveConversationsOnKeypress ; On Backspace Key Pressed
		endif
	endif
end

begin MenuMode 1013
	if IsModLoaded "The Mod Configuration Menu.esp"
	else
		Return
	endif

	if GetUIFloat "StartMenu/MCM/_ActiveMod" == GetModIndex "PantellaTTW.esm"
		set iOption to GetUIFloat "StartMenu/MCM/_ActiveOption"
		set fValue to GetUIFloat "StartMenu/MCM/_Value"

		if GetUIFloat "StartMenu/MCM/_Reset"			;1 - RESET
			SetUIFloat "StartMenu/MCM/_Reset" 0

			SetUIFloat "StartMenu/MCM/*:1/_columns" 1
			
			SetUIFloat "StartMenu/MCM/*:1/*:3/_enable" 1
			SetUIString "StartMenu/MCM/*:1/*:3/_title" "Add To Conversation Hotkey"
			SetUIFloat "StartMenu/MCM/*:1/*:3/_type" 3
			SetUIStringEx "StartMenu/MCM/*:1/*:3/value/*:1/string" "%k" AddToConversationKeyCode

			SetUIFloat "StartMenu/MCM/*:1/*:4/_enable" 1
			SetUIString "StartMenu/MCM/*:1/*:4/_title" "Clear Active Conversations Hotkey"
			SetUIFloat "StartMenu/MCM/*:1/*:4/_type" 3
			SetUIStringEx "StartMenu/MCM/*:1/*:4/value/*:1/string" "%k" ClearActiveConversationsKeyCode

			SetUIFloat "StartMenu/MCM/*:1/*:5/_enable" 1
			SetUIString "StartMenu/MCM/*:1/*:5/_title" "Open Text Menu Hotkey"
			SetUIFloat "StartMenu/MCM/*:1/*:5/_type" 3
			SetUIStringEx "StartMenu/MCM/*:1/*:5/value/*:1/string" "%k" OpenTextMenuKeyCode

			SetUIFloat "StartMenu/MCM/*:1/*:6/_enable" 1
			SetUIString "StartMenu/MCM/*:1/*:6/_title" "Microphone Enabled"
			SetUIFloat "StartMenu/MCM/*:1/*:6/_type" 4
			SetUIFloat "StartMenu/MCM/*:1/*:6/_value" microphoneEnabled

		elseif GetUIFloat "StartMenu/MCM/_Default"		;2 - DEFAULT
			SetUIFloat "StartMenu/MCM/_Default" 0
			SetUIFloat "StartMenu/MCM/_Reset" 1


			; Set default key code for Add To Conversation to H key
			RemoveEventHandler "OnKeyDown:"+ $AddToConversationKeyCode PantellaAddToConversation
			AddToConversationKeyCode = 35
			SetUIFloat "StartMenu/MCM/*:1/*:3/value/*:1/number" AddToConversationKeyCode
			SetEventHandler "OnKeyDown:"+ $AddToConversationKeyCode PantellaAddToConversation
			; Set default key code for Clear Active Conversations to Backspace key
			RemoveEventHandler "OnKeyDown:"+ $ClearActiveConversationsKeyCode PantellaClearActiveConversationsOnKeypress
			ClearActiveConversationsKeyCode = 14
			SetUIFloat "StartMenu/MCM/*:1/*:4/value/*:1/number" ClearActiveConversationsKeyCode
			SetEventHandler "OnKeyDown:"+ $ClearActiveConversationsKeyCode PantellaClearActiveConversationsOnKeypress
			; Set default key code for Open Text Menu to B key
			RemoveEventHandler "OnKeyDown:"+ $OpenTextMenuKeyCode PantellaOpenTextMenu
			OpenTextMenuKeyCode = 48
			SetUIFloat "StartMenu/MCM/*:1/*:5/value/*:1/number" OpenTextMenuKeyCode
			SetEventHandler "OnKeyDown:"+ $OpenTextMenuKeyCode PantellaOpenTextMenu

			; Set default value for microphone enabled to 0 (disabled)
			microphoneEnabled = 0
			SetUIFloat "StartMenu/MCM/*:1/*:6/_value" microphoneEnabled
			WriteStringToFile "_pantella_microphone_enabled.txt" 0 "False"

		elseif GetUIFloat "StartMenu/MCM/_NewValue"		;3 - NEW VALUE
			SetUIFloat "StartMenu/MCM/_NewValue" 0
			SetUIFloat "StartMenu/MCM/_Reset" 1

			if iOption == 3
				RemoveEventHandler "OnKeyDown:"+ $AddToConversationKeyCode PantellaAddToConversation
				AddToConversationKeyCode = fValue
				SetUIStringEx "StartMenu/MCM/*:1/*:3/value/*:1/string" "%k" AddToConversationKeyCode
				SetEventHandler "OnKeyDown:"+ $AddToConversationKeyCode PantellaAddToConversation
			elseif iOption == 4
				RemoveEventHandler "OnKeyDown:"+ $ClearActiveConversationsKeyCode PantellaClearActiveConversationsOnKeypress
				ClearActiveConversationsKeyCode = fValue
				SetUIStringEx "StartMenu/MCM/*:1/*:4/value/*:1/string" "%k" ClearActiveConversationsKeyCode
				SetEventHandler "OnKeyDown:"+ $ClearActiveConversationsKeyCode PantellaClearActiveConversationsOnKeypress
			elseif iOption == 5
				RemoveEventHandler "OnKeyDown:"+ $OpenTextMenuKeyCode PantellaOpenTextMenu
				OpenTextMenuKeyCode = fValue
				SetUIStringEx "StartMenu/MCM/*:1/*:5/value/*:1/string" "%k" OpenTextMenuKeyCode
				SetEventHandler "OnKeyDown:"+ $OpenTextMenuKeyCode PantellaOpenTextMenu
			elseif iOption == 6
				microphoneEnabled = fValue
				SetUIFloat "StartMenu/MCM/*:1/*:6/_value" microphoneEnabled
				if microphoneEnabled == 1
					WriteStringToFile "_pantella_microphone_enabled.txt" 0 "True"
				else
					WriteStringToFile "_pantella_microphone_enabled.txt" 0 "False"
				endif
			endif

		elseif GetUIFloat "StartMenu/MCM/_ShowList" == 1		;4 - SHOW LIST
			SetUIFloat "StartMenu/MCM/_ShowList" 2

		elseif GetUIFloat "StartMenu/MCM/_ShowScale" == 1		;5 - SHOW SCALE
			SetUIFloat "StartMenu/MCM/_ShowScale" 2

		elseif GetUIFloat "StartMenu/MCM/_DefaultScale"		;6 - DEFAULT SCALE
			SetUIFloat "StartMenu/MCM/_DefaultScale" 0
			SetUIFloat "StartMenu/MCM/_ShowScale" 2

		endif

		if iMouseover != GetUIFloat "StartMenu/MCM/*:1/_optionID"		;7 - MOUSE-OVER
			set iMouseover to GetUIFloat "StartMenu/MCM/*:1/_optionID"
			if iMouseover
				SetUIFloat "StartMenu/MCM/*:9/visible" 1
				if iMouseover == 3
					SetUIString "StartMenu/MCM/*:9/string" "Sets the hotkey for adding the current speaker to the conversation. Default is H key."
				elseif iMouseover == 4
					SetUIString "StartMenu/MCM/*:9/string" "Sets the hotkey for clearing active conversations. Default is Backspace key."
				elseif iMouseover == 5
					SetUIString "StartMenu/MCM/*:9/string" "Sets the hotkey for opening the text menu. Default is B key."
				elseif iMouseover == 6
					SetUIString "StartMenu/MCM/*:9/string" "Toggles whether the microphone is enabled for use in conversations. Default is disabled."
				else
					SetUIFloat "StartMenu/MCM/MCM_Info/visible" 0
				endif
			else
				SetUIFloat "StartMenu/MCM/MCM_Info/visible" 0
			endif
		endif
	endif
end